# ===========================================
# Python-Web — Переменные окружения
# ===========================================
# Скопируйте в .env и заполните значения.
# PHP-файлы песочницы читают эти переменные через getenv().
# JS-файлы являются статическими и не читают .env напрямую.

# ─── Песочница (PHP) ───

# Базовый URL сайта (для CORS и редиректов)
SANDBOX_BASE_URL=https://python.nayanovaacademy.ru

# Разрешённый origin для CORS-запросов к песочнице
SANDBOX_ALLOWED_ORIGIN=https://python.nayanovaacademy.ru

# Доверенные прокси (через запятую, для X-Forwarded-For). Пусто = не доверять.
SANDBOX_TRUSTED_PROXIES=

# Лимиты песочницы
SANDBOX_MAX_CODE_LENGTH=65536
SANDBOX_MAX_INPUT_LENGTH=102400
SANDBOX_MAX_OUTPUT_SIZE=1048576
SANDBOX_DEFAULT_TIMEOUT=5
SANDBOX_MEMORY_LIMIT_MB=128
SANDBOX_RATE_LIMIT=10
SANDBOX_RATE_WINDOW=60
SANDBOX_SESSION_MAX_SIZE=10485760

# ─── Аналитика (JS) ───
# Google Analytics Measurement ID (вставлен в ga.js вручную)
GA_MEASUREMENT_ID=G-Q5ZWEHXWYF
