<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' https://www.google-analytics.com; font-src 'self'; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'" />
    <meta name="description" content="{% if description %}{{ description }}{% elif subtitle %}Урок {{ lesson }}: {{ subtitle }}{% else %}Урок {{ lesson }} курса Python{% endif %}" />
    <meta property="og:title" content="{{ lesson }}. {{ title }} — Python: основы" />
    <meta property="og:description" content="{% if description %}{{ description }}{% elif subtitle %}{{ subtitle }}{% else %}Урок {{ lesson }} курса Python{% endif %}" />
    <meta property="og:type" content="article" />
    <meta property="og:image" content="https://python.nayanovaacademy.ru/favicon.png" />
    <meta property="og:url" content="https://python.nayanovaacademy.ru/{{ page.fileSlug }}.html" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="{{ lesson }}. {{ title }} — Python: основы" />
    <meta name="twitter:description" content="{% if description %}{{ description }}{% elif subtitle %}{{ subtitle }}{% else %}Урок {{ lesson }} курса Python{% endif %}" />
    <meta name="twitter:image" content="https://python.nayanovaacademy.ru/favicon.png" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href="https://python.nayanovaacademy.ru/{{ page.fileSlug }}.html" />
    <title>{{ title }} — Python: основы</title>
    <link rel="stylesheet" href="style.css" />
    <link rel="icon" type="image/png" href="favicon.png" />
    <link rel="stylesheet" href="highlight-theme.min.css" />
  </head>
  <body data-lesson="{{ lesson }}">
    <noscript><div style="padding:40px;text-align:center;font-size:1.2em;">Для работы сайта необходим JavaScript.</div></noscript>
    <a href="#main-content" class="skip-link">Перейти к содержанию</a>
    <div class="container">
      <header class="topic-header">
        <div id="breadcrumbs" class="breadcrumbs"></div>
        <h1><span class="lesson-badge">Урок {{ lesson }}</span> {{ title }}</h1>
        {% if subtitle %}<p class="subtitle">{{ subtitle }}</p>{% endif %}
        {% if duration %}<div class="lesson-meta-info"><span class="meta-duration">⏱ ~{{ duration }} мин чтения</span>{% if complexity %}<span class="meta-sep">·</span> <span class="meta-complexity" data-level="{{ complexity }}">{% if complexity == "1" %}🚀 Начальный{% elif complexity == "2" %}📘 Базовый{% elif complexity == "3" %}📗 Средний{% elif complexity == "4" %}📙 Продвинутый{% else %}{{ complexity }}{% endif %}</span>{% endif %}</div>{% endif %}
      </header>
      <div class="content-layout">
        <aside id="toc"></aside>
        <main id="main-content">
          {{ content | safe }}
        </main>
      </div>
      <footer class="topic-footer">
        {% if prevUrl %}<a href="{{ prevUrl }}" class="prev-link">← {{ prevTitle }}</a>{% endif %}
        {% if nextUrl %}<a href="{{ nextUrl }}" class="next-link">Далее: {{ nextTitle }} →</a>{% endif %}
      </footer>
    </div>
    <script defer src="highlight-py.min.js"></script>
    <script src="config.js"></script>
    <script src="script.js"></script>
  </body>
</html>
