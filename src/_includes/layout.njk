<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' https://mc.yandex.ru; style-src 'self'; img-src 'self' data: https://mc.yandex.ru; connect-src 'self' https://mc.yandex.ru https://auth.nayanovaacademy.ru https://contest.nayanovaacademy.ru wss://mc.yandex.ru; font-src 'self'; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self' https://auth.nayanovaacademy.ru; upgrade-insecure-requests" />
    <meta name="description" content="{% if description %}{{ description }}{% elif subtitle %}Урок {{ lesson }}: {{ subtitle }}{% else %}Урок {{ lesson }} курса Python{% endif %}" />
    <meta property="og:title" content="{{ lesson }}. {{ title }} — Python: основы" />
    <meta property="og:description" content="{% if description %}{{ description }}{% elif subtitle %}{{ subtitle }}{% else %}Урок {{ lesson }} курса Python{% endif %}" />
    <meta property="og:type" content="article" />
    {% if date %}<meta property="article:published_time" content="{{ date | date('YYYY-MM-DD') }}" />{% endif %}
    <meta property="og:image" content="{{ site.url }}/og-image.png" />
    <meta property="og:url" content="{{ site.url }}/{{ page.fileSlug }}.html" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="{{ lesson }}. {{ title }} — Python: основы" />
    <meta name="twitter:description" content="{% if description %}{{ description }}{% elif subtitle %}{{ subtitle }}{% else %}Урок {{ lesson }} курса Python{% endif %}" />
    <meta name="twitter:image" content="{{ site.url }}/og-image.png" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href="{{ site.url }}/{{ page.fileSlug }}.html" />
    <title>{{ title }} — Python: основы</title>
    <link rel="preload" href="highlight-theme.min.css" as="style" />
    <link rel="stylesheet" href="style.css" />
    <link rel="icon" type="image/png" href="favicon.png" />
    <link rel="stylesheet" href="highlight-theme.min.css" />
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "TechArticle",
      "headline": "{{ title }}",
      "description": "{% if description %}{{ description }}{% elif subtitle %}{{ subtitle }}{% else %}Урок {{ lesson }} курса Python{% endif %}",
      "educationalLevel": "{% if complexity == 'advanced' %}advanced{% else %}beginner{% endif %}",
      "proficiencyLevel": "{{ complexity | default('beginner') }}",
      "author": { "@type": "Organization", "name": "Python Web" },
      "publisher": { "@type": "Organization", "name": "Python Web" },
      "datePublished": "{% if date %}{{ date | date('YYYY-MM-DD') }}{% else %}{{ site.launchDate }}{% endif %}",
      "mainEntityOfPage": { "@type": "WebPage", "@id": "{{ site.url }}/{{ page.fileSlug }}.html" },
      "isPartOf": { "@type": "Course", "name": "Python — Основы программирования" },
      {% if duration %}"timeRequired": "PT{{ duration }}M",{% endif %}
      "inLanguage": "ru"
    }
    </script>
    <!-- Yandex.Metrika -->
    <script defer src="ym-init.js"></script>
    <noscript><div><img class="ym-pixel" src="https://mc.yandex.ru/watch/{{ site.yandexMetrikaId }}" alt="" /></div></noscript>
    <!-- /Yandex.Metrika counter -->
  </head>
  <body data-lesson="{{ lesson }}">
    <noscript><div class="noscript-banner" role="alert">\u0414\u043b\u044f \u0440\u0430\u0431\u043e\u0442\u044b \u0441\u0430\u0439\u0442\u0430 \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c JavaScript.</div></noscript>
    <a href="#main-content" class="skip-link">Перейти к содержанию</a>
    <div class="container">
      <header class="topic-header" aria-label="Заголовок урока">
        <nav aria-label="Хлебные крошки">
          <div id="breadcrumbs" class="breadcrumbs"></div>
        </nav>
        <h1><span class="lesson-badge">Урок {{ lesson }}</span> {{ title }}</h1>
        {% if subtitle %}<p class="subtitle">{{ subtitle }}</p>{% endif %}
        {% if duration %}<div class="lesson-meta-info"><span class="meta-duration">⏱ ~{{ duration }} мин чтения</span>{% if complexity %}<span class="meta-sep">·</span> <span class="meta-complexity" data-level="{{ complexity }}">{% if complexity == "beginner" %}🚀 Начальный{% elif complexity == "basic" %}📘 Базовый{% elif complexity == "intermediate" %}📗 Средний{% elif complexity == "advanced" %}📙 Продвинутый{% else %}{{ complexity }}{% endif %}</span>{% endif %}</div>{% endif %}
      </header>
      <div class="content-layout">
        <nav id="toc" aria-label="Содержание урока"></nav>
        <main id="main-content">
          {{ content | safe }}
        </main>
      </div>
      <footer class="topic-footer" aria-label="Навигация по урокам">
        {% if prevUrl %}<a href="{{ prevUrl }}" class="prev-link" rel="prev">← {{ prevTitle }}</a>{% endif %}
        {% if nextUrl %}<a href="{{ nextUrl }}" class="next-link" rel="next">Далее: {{ nextTitle }} →</a>{% endif %}
      </footer>
    </div>
    <script defer src="highlight-py.min.js"></script>
    <script type="module" src="script.js"></script>
  </body>
</html>
