<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' https://mc.yandex.ru; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://mc.yandex.ru; connect-src 'self' https://mc.yandex.ru https://auth.nayanovaacademy.ru wss://mc.yandex.ru; font-src 'self'; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self' https://auth.nayanovaacademy.ru; upgrade-insecure-requests" />
    <meta name="description" content="{% if description %}{{ description }}{% else %}Изучайте Python с нуля — 50 интерактивных уроков с примерами кода.{% endif %}" />
    <meta property="og:title" content="Python — Основы программирования" />
    <meta property="og:description" content="50 уроков по Python для начинающих: от переменных до Git. Бесплатно, с примерами кода." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="{{ site.url }}/" />
    <meta property="og:image" content="{{ site.url }}/og-image.png" />
    <meta property="og:locale" content="ru_RU" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Python — Основы программирования" />
    <meta name="twitter:description" content="50 уроков по Python для начинающих: от переменных до Git. Бесплатно, с примерами кода." />
    <meta name="twitter:image" content="{{ site.url }}/og-image.png" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href="{{ site.url }}/" />
    <title>Основы программирования на Python — 50 уроков для начинающих</title>
    <link rel="preload" href="highlight-theme.min.css" as="style" />
    <link rel="stylesheet" href="style.css" />
    <link rel="icon" type="image/png" href="favicon.png" />
    <link rel="apple-touch-icon" href="apple-touch-icon.png" />
    <meta name="theme-color" content="#667eea" />
    <link rel="manifest" href="manifest.json" />
    <link rel="stylesheet" href="highlight-theme.min.css" id="hljs-theme" />
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Course",
      "name": "Python — Основы программирования",
      "description": "Изучайте Python с нуля — 50 интерактивных уроков с примерами кода, подсветкой синтаксиса и отслеживанием прогресса.",
      "provider": { "@type": "Organization", "name": "Python Web" },
      "educationalLevel": "beginner",
      "numberOfLessons": "50",
      "inLanguage": "ru",
      "hasCourseInstance": [{ "@type": "CourseInstance", "courseMode": ["online", "MOOC"], "inLanguage": "ru" }]
    }
    </script>
    <!-- Yandex.Metrika -->
    <script defer src="ym-init.js"></script>
    <noscript><div><img class="ym-pixel" src="https://mc.yandex.ru/watch/{{ site.yandexMetrikaId }}" alt="" /></div></noscript>
    <!-- /Yandex.Metrika counter -->
  </head>
  <body class="index-page">
    <noscript><div class="noscript-banner" role="alert">\u0414\u043b\u044f \u0440\u0430\u0431\u043e\u0442\u044b \u0441\u0430\u0439\u0442\u0430 \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c JavaScript.</div></noscript>
    <a href="#main-content" class="skip-link">Перейти к содержанию</a>
    <div class="container index-container">
      <header class="index-header">
        <h1>🐍 <span>Python</span> — основы программирования</h1>
        <p>50 тем для начинающих с примерами кода</p>
        <div class="progress-bar-container" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" aria-label="Прогресс прохождения курса"></div>
        <span class="progress-info"></span>
        <div class="repl-auth-wrapper">
          <a href="repl.html" class="repl-hero-btn">▶ Интерактивная консоль Python</a>
        </div>
        <!-- Блок достижений (badges) -->
        <div class="badges-section" id="badgesBlock" hidden>
          <div class="badges-title">🏆 Достижения</div>
          <div class="badges-grid" id="badgesGrid"></div>
        </div>
      </header>

      <div class="search-container">
        <label for="lesson-search" class="sr-only">Поиск уроков</label>
        <input type="text" id="lesson-search" class="search-input" placeholder="🔍 Поиск уроков... (попробуйте: циклы, строки, функции)" autocomplete="off" />
      </div>

      <main class="index-nav" id="main-content">
        {% for section in collections.sections %}
        <div class="section-group" data-section="{{ section.id }}" id="section-{{ section.id }}">
          <h2 class="section-title">{{ section.title }}</h2>
          <div class="section-cards">
            {% for lesson in section.lessons %}
            <a href="{{ lesson.url }}" class="topic-card" data-lesson="{{ lesson.num }}">
              <div class="topic-num">{{ lesson.num }}</div>
              <div class="topic-info">
                <h2>{{ lesson.title }}</h2>
                <p>{{ lesson.desc }}</p>
                {% if lesson.duration %}<div class="topic-meta"><span class="meta-duration">⏱ {{ lesson.duration }} мин</span> · <span class="meta-complexity" data-level="{{ lesson.complexity }}">{% if lesson.complexity == 'beginner' %}🚀 Начальный{% elif lesson.complexity == 'basic' %}📘 Базовый{% elif lesson.complexity == 'intermediate' %}📗 Средний{% elif lesson.complexity == 'advanced' %}📙 Продвинутый{% else %}{{ lesson.complexity }}{% endif %}</span></div>{% endif %}
              </div>
            </a>
            {% endfor %}
          </div>
        </div>
        {% endfor %}
      </main>
      <footer class="index-footer">
        Создано для изучения основ Python. Все примеры можно запустить в интерпретаторе.
      </footer>
    </div>

    <script defer src="highlight-py.min.js"></script>
    <script type="module" src="script.js"></script>
  </body>
</html>
