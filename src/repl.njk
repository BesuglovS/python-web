  <link rel="canonical" href="{{ site.url }}/repl.html" />
  <title>🐍 Python REPL — Интерактивная консоль</title>
  <link rel="stylesheet" href="style.css" />
  <link rel="icon" type="image/png" href="favicon.png" />
  <script defer src="ym-init.js"></script>
  <noscript><div><img class="ym-pixel" src="https://mc.yandex.ru/watch/{{ site.yandexMetrikaId }}" alt="" /></div></noscript>
