  <meta name="description" content="Интерактивная Python-консоль — пиши код и сразу видь результат." />
  <meta property="og:title" content="Python REPL — Интерактивная консоль" />
  <meta property="og:description" content="Интерактивная Python-консоль — пиши код и сразу видь результат." />
