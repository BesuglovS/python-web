# Security Headers
<IfModule mod_headers.c>
    # Strict-Transport-Security (enforce HTTPS + preload)
    Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
    # Prevent MIME-type sniffing
    Header always set X-Content-Type-Options "nosniff"
    # Prevent clickjacking
    Header always set X-Frame-Options "DENY"
    # Content Security Policy — каноническая политика, идентичная meta-CSP
    # в layout.njk / layout-index.njk и header-CSP в nginx-конфиге.
    # (frame-ancestors в meta не поддерживается браузерами — работает только здесь.)
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self' https://auth.nayanovaacademy.ru https://contest.nayanovaacademy.ru; font-src 'self'; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self' https://auth.nayanovaacademy.ru; upgrade-insecure-requests; frame-ancestors 'none'"
    # Referrer policy
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    # Permissions policy (restrict browser features)
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
</IfModule>

# Service Worker и tracking-client должны всегда быть свежими,
# иначе обновления сайта тормозятся HTTP-кэшем на год.
<FilesMatch "^(sw|tracking-client)\.js$">
    <IfModule mod_headers.c>
        Header set Cache-Control "no-cache"
    </IfModule>
</FilesMatch>

# База данных прогресса и любые файлы data/ не отдаются веб-сервером.
# (Параллельное правило есть в nginx-конфиге: location ^~ /data/ { deny all; })
RedirectMatch 404 ^/data/

# Cache-Control for static assets
<IfModule mod_expires.c>
    ExpiresActive On
    # CSS and JS — 1 year (cache-busted via build hash or filename)
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"
    # Images — 1 year
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    # Fonts — 1 year
    ExpiresByType font/woff2 "access plus 1 year"
    # JSON / manifest — не кэшируем (контент меняется при деплое)
    ExpiresByType application/json "access plus 0 seconds"
    ExpiresByType application/manifest+json "access plus 0 seconds"
    # HTML — не кэшируем (контент меняется при деплое)
    ExpiresByType text/html "access plus 0 seconds"
    # Default — 1 day
    ExpiresDefault "access plus 1 day"
</IfModule>

# Compress text-based resources
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json text/xml image/svg+xml
</IfModule>

# Disable directory listing
Options -Indexes

# Custom error pages
ErrorDocument 404 /404.html
ErrorDocument 500 /500.html
