# Security Headers
<IfModule mod_headers.c>
    # Strict-Transport-Security (enforce HTTPS + preload)
    Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
    # Prevent MIME-type sniffing
    Header always set X-Content-Type-Options "nosniff"
    # Prevent clickjacking
    Header always set X-Frame-Options "DENY"
    # Content Security Policy (moved from <meta> for frame-ancestors/report-uri support)
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://mc.yandex.ru; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://mc.yandex.ru; connect-src 'self' https://mc.yandex.ru https://contest.nayanovaacademy.ru wss://mc.yandex.ru; font-src 'self'; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'"
    # Referrer policy
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    # Permissions policy (restrict browser features)
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
</IfModule>

# Cache-Control for static assets
<IfModule mod_expires.c>
    ExpiresActive On
    # CSS and JS — 1 year (cache-busted via build hash or filename)
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"
    # Images — 1 year
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    # Fonts — 1 year
    ExpiresByType font/woff2 "access plus 1 year"
    # JSON / manifest — 1 hour
    ExpiresByType application/json "access plus 1 hour"
    ExpiresByType application/manifest+json "access plus 1 hour"
    # HTML — 1 hour
    ExpiresByType text/html "access plus 1 hour"
    # Default — 1 day
    ExpiresDefault "access plus 1 day"
</IfModule>

# Compress text-based resources
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json text/xml image/svg+xml
</IfModule>

# Disable directory listing
Options -Indexes

# Custom error pages
ErrorDocument 404 /404.html
ErrorDocument 500 /500.html
