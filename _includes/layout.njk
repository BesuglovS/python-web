---
layout: null
---
<!DOCTYPE html>
<html lang="ru" {{ data.lang }} data-theme="{{ data.theme }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ data.title }} — Python Web</title>
  <link rel="stylesheet" href="/highlight-theme.min.css">
  <link rel="stylesheet" href="/style.css">
</head>
<body {{ data.bodyclass }}>
  <header id="header">
    <a href="/" class="home-link" aria-label="Перейти на главную">
      <svg width="42" height="42" viewBox="0 0 64 64" aria-hidden="true">
        <ellipse cx="32" cy="32" rx="28" ry="22" fill="url(#grad1)"/>
        <text x="14" y="38" font-family="system-ui" font-weight="bold" font-size="18" fill="white">Py</text>
        <defs>
          <linearGradient id="grad1" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" style="stop-color:#667eea"/>
            <stop offset="100%" style="stop-color:#764ba2"/>
          </linearGradient>
        </defs>
      </svg>
    </a>
    <h1>{{ data.site_title }}</h1>
    <p>Изучение программирования на Python онлайн</p>
    <div class="progress-bar-container">
      <div class="progress-info">
        <span class="progress-text">{{ data.progress }}%</span>
        <span class="progress-label">Пройто уроков</span>
      </div>
      <div class="progress-bar" role="progressbar" aria-label="Прогресс" aria-valuenow="{{ data.progress }}" aria-valuemin="0" aria-valuemax="100">
        <div class="progress-fill" style="width: {{ data.progress }}%;"></div>
      </div>
    </div>
    <nav id="nav-top" class="nav-top">
      {{ data.nav_top }}
    </nav>
  </header>

  <main id="main" class="main">
    {{ content }}
  </main>

  <footer id="footer">
    <div class="footer-links">
      {{ data.footer_links }}
    </div>
    <p class="copyright">
      © {{ data.year }} Курс Python. <a href="https://github.com/your-repo/python-web" target="_blank" rel="noopener">Лицензия MIT</a>
    </p>
  </footer>

  {{ data.extra_head }}

  <script src="/ym-init.js"></script>
  {{ data.extra_js }}
</html>
