{
  "name": "python-web",
  "version": "1.2.0",
  "description": "Курс по изучению программирования на Python",
  "private": true,
  "scripts": {
    "build": "eleventy",
    "build:hljs": "node build-highlight.mjs",
    "build:meta": "node build-config-meta.mjs",
    "build:js": "node build-js.mjs",
    "build:sw": "node build-sw.mjs",
    "build:assets": "node build-assets-hash.mjs",
    "build:og": "python build-og-image.py",
    "build:prod": "node -e \"require('fs').mkdirSync('dist',{recursive:true})\" && node build-config-meta.mjs && node build-highlight.mjs && eleventy && node build-js.mjs && node minify.js && node build-sw.mjs && node build-assets-hash.mjs",
    "watch": "eleventy --serve",
    "minify": "node minify.js",
    "lint": "eslint . --ext .js,.ts,.mjs",
    "lint:fix": "eslint . --ext .js,.ts,.mjs --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:unit": "vitest run",
    "test:unit:coverage": "vitest run --coverage",
    "test:unit:watch": "vitest",
    "test:php": "php tests/test_sandbox.php",
    "test:python": "python -m pytest tests/test_ast_validator.py -v",
    "typecheck": "tsc --noEmit",
    "prepare": "node -e \"try{require('child_process').execSync('npx husky',{stdio:'ignore'})}catch(e){}\""
  },
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@eslint/js": "^9.28.0",
    "@playwright/test": "^1.61.1",
    "@types/luxon": "^3.4.2",
    "@types/node": "^22.5.0",
    "@vitest/coverage-v8": "^3.2.7",
    "clean-css": "^5.3.3",
    "esbuild": "^0.28.1",
    "eslint": "^9.28.0",
    "globals": "^15.9.0",
    "happy-dom": "^20.10.6",
    "highlight.js": "^11.11.1",
    "http-server": "^14.1.1",
    "lint-staged": "^15.4.3",
    "luxon": "^3.6.1",
    "prettier": "^3.5.3",
    "terser": "^5.49.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.3.0",
    "vitest": "^3.2.1"
  }
}
